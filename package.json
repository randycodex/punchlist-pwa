{
  "name": "punchlist-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build-offline.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build",
    "thread:new": "bash ./scripts/new-thread.sh",
    "thread:list": "git worktree list",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "verify:release": "npm run verify && npm run audit:production && npm run audit:all",
    "recovery:rehearse": "vitest run tests/recoveryRehearsal.test.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.563.0",
    "next": "^16.3.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^13.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
